{
  "name": "gif-drop",
  "version": "1.1.1",
  "description": "範囲を選び、動画を美しいGIFへ変換するMacアプリ",
  "main": "electron/main.cjs",
  "author": "GIF DROP contributors",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "start": "npm run vendor && electron .",
    "dist:mac": "npm run vendor && electron-builder --mac --universal --publish never"
  },
  "dependencies": {
    "gif.js.optimized": "1.0.1"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "jp.gifdrop.app",
    "productName": "GIF DROP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "GIF DROP ${version}",
      "artifactName": "GIF-DROP-${version}-universal.${ext}"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
